%% /etc/rabbitmq/inter_node_tls.config
[
  {server, [
    {cacertfile, "/etc/pcc-tls/ca.pem"},
    {certfile,   "/etc/pcc-tls/rabbitmq.crt"},
    {keyfile,    "/etc/pcc-tls/rabbitmq.key"},
    {secure_renegotiate, true},
    {verify, verify_peer},
    {fail_if_no_peer_cert, true}
  ]},
  {client, [
    {cacertfile, "/etc/pcc-tls/ca.pem"},
    {certfile,   "/etc/pcc-tls/rabbitmq.crt"},
    {keyfile,    "/etc/pcc-tls/rabbitmq.key"},
    {secure_renegotiate, true},
    {verify, verify_peer}
  ]}
].
